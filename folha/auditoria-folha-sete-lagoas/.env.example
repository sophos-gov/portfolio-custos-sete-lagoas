# ===== Chaves de API =====
# Anthropic (roteador do loop agêntico + síntese Opus). Sem créditos -> o harness
# degrada para Gemini Flash + pipeline determinístico (ainda produz o dashboard).
ANTHROPIC_API_KEY=sk-ant-...

# Gemini (modelo barato primário: classificação de rubricas + narrativa).
GEMINI_API_KEY=AIza...

# DeepSeek (modelo barato secundário — entra quando o Gemini bate limite de requisições).
DEEPSEEK_API_KEY=sk-...

# Telegram (notificação de conclusão via @cortereal_bot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=8969330678

# ===== Modelos (ajuste conforme acesso da sua conta) =====
ROUTER_MODEL=claude-sonnet-4-6
SYNTH_MODEL=claude-opus-4-8
GEMINI_MODEL=gemini-2.5-flash
DEEPSEEK_MODEL=deepseek-chat

# ===== Guardrails do agente noturno =====
AGENT_USD_BUDGET=3.0
AGENT_MAX_ITERATIONS=120
AGENT_MAX_WALL_SECONDS=14400

# Domínios permitidos para scraping de legislação (whitelist)
LAW_SCRAPE_DOMAINS=leismunicipais.com.br,camarasetelagoas.mg.gov.br,setelagoas.mg.leg.br,jusbrasil.com.br
