<script>
(function(){
  var root = document.documentElement;
  var btn = document.getElementById('themeBtn');
  if (btn) {
    btn.addEventListener('click', function(){
      var atual = root.getAttribute('data-theme');
      if (!atual) {
        atual = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
      root.setAttribute('data-theme', atual === 'dark' ? 'light' : 'dark');
    });
  }

  var secoes = ['abertura','sumario','educacao','saude','contratos'];
  var links = {};
  document.querySelectorAll('.nav-links a').forEach(function(a){
    var alvo = a.getAttribute('href');
    if (alvo && alvo.charAt(0) === '#') links[alvo.slice(1)] = a;
  });
  var alvos = ['abertura','educacao','saude','contratos'].map(function(id){
    return document.getElementById(id);
  }).filter(Boolean);

  if ('IntersectionObserver' in window && alvos.length) {
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if (!e.isIntersecting) return;
        Object.keys(links).forEach(function(k){ links[k].classList.remove('on'); });
        var l = links[e.target.id];
        if (l) l.classList.add('on');
      });
    }, { rootMargin: '-40% 0px -55% 0px' });
    alvos.forEach(function(s){ io.observe(s); });
  }
})();
</script>


